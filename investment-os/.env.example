# --- Database (Phase 2) ---
DATABASE_URL="postgresql://investos:investos@localhost:5432/investment_os?schema=public"

# --- Backend server ---
PORT=4000
NODE_ENV=development

# --- External data providers (Phase 3) ---
# Live data works WITHOUT any keys: prices/indices come from Yahoo Finance and
# news from Google News RSS (both free & keyless). These optional keys are only
# for upgrading to a paid/dedicated provider later; leave blank to use the free
# sources (with automatic mock fallback if a source is unreachable).
STOCK_API_KEY=
NEWS_API_KEY=
MACRO_API_KEY=

# --- AI provider (Phase 8 / 11) ---
# Optional: when set, the AI chat + summary routes call a real LLM.
# Leave blank to use the built-in heuristic engine.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
