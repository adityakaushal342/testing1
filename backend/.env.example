# Copy to .env and adjust. All values have safe dev defaults, so the app runs with none set.

# --- Security (CHANGE IN PRODUCTION) ---
# Generate a strong one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Dev (default): SQLite file. Production example (Postgres):
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tradingmaster
DATABASE_URL=sqlite:///./tradingmaster.db

# --- Auth behaviour ---
REQUIRE_VERIFICATION=true
VERIFY_TOKEN_EXPIRE_H=24
RESET_TOKEN_EXPIRE_MIN=30
# DEV ONLY: return verify/reset links in API responses + log emails to console. Set false in prod.
DEV_EXPOSE_TOKENS=true

# --- URLs ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*

# --- Email / SMTP (leave SMTP_HOST empty to log emails instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Trading Master <no-reply@aitradingmaster.local>
SMTP_TLS=true

# --- Google OAuth (future) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
